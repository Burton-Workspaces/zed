#!/usr/bin/env python3
"""Serve Burton installers with Zed's auto-update JSON contract.

The app polls:

    GET {update_server_url}/releases/{channel}/{version}/asset
        ?asset=zed&os={linux|macos|windows}&arch={x86_64|aarch64}

and expects:

    {"version": "1.22.1", "url": "https://host/files/burton-linux-x86_64.tar.gz"}

`version` in the path is usually `latest`. Query `asset` stays `zed` (Zed protocol).
Override the baked-in host at runtime with ZED_SERVER_URL.
"""

from __future__ import annotations

import argparse
import json
import re
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlparse

SCRIPT_DIR = Path(__file__).resolve().parent
ROOT = SCRIPT_DIR.parent.parent

ASSET_NAMES = {
    ("linux", "x86_64"): ("burton-linux-x86_64.tar.gz",),
    ("linux", "aarch64"): ("burton-linux-aarch64.tar.gz",),
    ("macos", "x86_64"): ("Burton-x86_64.dmg",),
    ("macos", "aarch64"): ("Burton-aarch64.dmg",),
    ("windows", "x86_64"): ("Burton-x86_64.exe",),
    ("windows", "aarch64"): ("Burton-aarch64.exe",),
}

RELEASE_PATH = re.compile(r"^/releases/(?P<channel>[^/]+)/(?P<version>[^/]+)/asset/?$")


def crate_version(root: Path) -> str:
    text = (root / "crates" / "zed" / "Cargo.toml").read_text()
    match = re.search(r'(?m)^version\s*=\s*"([^"]+)"', text)
    if not match:
        raise SystemExit(f"could not read version from {root / 'crates' / 'zed' / 'Cargo.toml'}")
    return match.group(1)


def find_artifact(search_dirs: list[Path], names: tuple[str, ...]) -> Path | None:
    for directory in search_dirs:
        if not directory.is_dir():
            continue
        for name in names:
            direct = directory / name
            if direct.is_file():
                return direct
            matches = sorted(directory.rglob(name), key=lambda path: path.stat().st_mtime, reverse=True)
            if matches:
                return matches[0]
    return None


def make_handler(search_dirs: list[Path], version: str) -> type[BaseHTTPRequestHandler]:
    class Handler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, format: str, *args: object) -> None:
            sys.stderr.write("%s - %s\n" % (self.address_string(), format % args))

        def _send(self, status: int, body: bytes, content_type: str) -> None:
            self.send_response(status)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def _public_origin(self) -> str:
            host = self.headers.get("Host", "127.0.0.1")
            return f"http://{host}"

        def do_GET(self) -> None:  # noqa: N802
            parsed = urlparse(self.path)
            if parsed.path.startswith("/files/"):
                name = Path(parsed.path).name
                path = find_artifact(search_dirs, (name,))
                if path is None:
                    self._send(404, b"not found\n", "text/plain; charset=utf-8")
                    return
                data = path.read_bytes()
                self._send(200, data, "application/octet-stream")
                return

            match = RELEASE_PATH.match(parsed.path)
            if not match:
                self._send(404, b"not found\n", "text/plain; charset=utf-8")
                return

            query = parse_qs(parsed.query)
            asset = (query.get("asset") or ["zed"])[0]
            os_name = (query.get("os") or [""])[0]
            arch = (query.get("arch") or [""])[0]
            if asset != "zed":
                self._send(
                    404,
                    json.dumps({"error": f"unsupported asset {asset}"}).encode(),
                    "application/json",
                )
                return

            names = ASSET_NAMES.get((os_name, arch))
            if not names:
                self._send(
                    404,
                    json.dumps({"error": f"no artifact mapping for os={os_name} arch={arch}"}).encode(),
                    "application/json",
                )
                return

            path = find_artifact(search_dirs, names)
            if path is None:
                self._send(
                    404,
                    json.dumps({"error": f"missing {' or '.join(names)}"}).encode(),
                    "application/json",
                )
                return

            payload = {
                "version": version,
                "url": f"{self._public_origin()}/files/{path.name}",
            }
            self._send(200, json.dumps(payload).encode(), "application/json")

    return Handler


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dir", action="append", type=Path, help="Directory to search for installers (repeatable)")
    parser.add_argument("--version", help="Version string returned in the JSON body")
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=4180)
    args = parser.parse_args()

    search_dirs = [path.resolve() for path in (args.dir or [ROOT / "target"])]
    version = args.version or crate_version(ROOT)
    handler = make_handler(search_dirs, version)
    server = ThreadingHTTPServer((args.host, args.port), handler)
    print(
        f"Burton update server on http://{args.host}:{args.port}\n"
        f"  version: {version}\n"
        f"  files:   {', '.join(str(path) for path in search_dirs)}\n"
        f"Point a build at this host with ZED_SERVER_URL=http://{args.host}:{args.port}",
        flush=True,
    )
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")
    return 0


if __name__ == "__main__":
    sys.exit(main())
