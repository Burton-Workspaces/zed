#!/usr/bin/env bash
# Launch burton-update-dev (Burton updates + Zed extensions proxy).
#
# Usage:
#   burton/script/serve-updates --dir target --version 1.22.1
#   burton/script/serve-updates --listen 127.0.0.1:4180 --public-url https://updates.burton.dev
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT"
exec cargo run --manifest-path "$ROOT/burton/update-dev/Cargo.toml" --quiet -- "$@"
