#!/usr/bin/env python3
"""Create Burton dock icons: a simple mountain and lake silhouette."""

from __future__ import annotations

import struct
import zlib
from pathlib import Path

ASSETS = Path(__file__).resolve().parent.parent / "assets"
SKY = (32, 48, 66, 255)
MOUNTAIN_BACK = (156, 176, 196, 255)
MOUNTAIN_FRONT = (236, 240, 244, 255)
LAKE = (58, 112, 142, 255)
REFLECTION = (118, 168, 196, 255)
HORIZON = (186, 214, 228, 255)


def write_png(path: Path, width: int, height: int, pixels: bytearray) -> None:
    def chunk(tag: bytes, data: bytes) -> bytes:
        return (
            struct.pack(">I", len(data))
            + tag
            + data
            + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
        )

    raw = bytearray()
    stride = width * 4
    for y in range(height):
        raw.append(0)
        raw.extend(pixels[y * stride : (y + 1) * stride])
    ihdr = struct.pack(">IIBBBBB", width, height, 8, 6, 0, 0, 0)
    path.write_bytes(
        b"\x89PNG\r\n\x1a\n"
        + chunk(b"IHDR", ihdr)
        + chunk(b"IDAT", zlib.compress(bytes(raw), 9))
        + chunk(b"IEND", b"")
    )


def rounded_rect_coverage(px: float, py: float, x0: float, y0: float, x1: float, y1: float, radius: float) -> float:
    if px < x0 or px >= x1 or py < y0 or py >= y1:
        return 0.0
    cx = min(max(px, x0 + radius), x1 - radius)
    cy = min(max(py, y0 + radius), y1 - radius)
    if abs(px - cx) <= 0.5 and abs(py - cy) <= 0.5:
        return 1.0
    dx = px + 0.5 - cx
    dy = py + 0.5 - cy
    dist = (dx * dx + dy * dy) ** 0.5
    if dist <= radius - 0.6:
        return 1.0
    if dist >= radius + 0.6:
        # still inside the straight body?
        if x0 + radius <= px + 0.5 <= x1 - radius or y0 + radius <= py + 0.5 <= y1 - radius:
            return 1.0
        return 0.0
    return max(0.0, min(1.0, radius + 0.6 - dist))


def blend(dst: bytearray, index: int, color: tuple[int, int, int, int], alpha: float) -> None:
    if alpha <= 0:
        return
    ia = int(alpha * color[3])
    if ia <= 0:
        return
    inv = 255 - ia
    dst[index] = (dst[index] * inv + color[0] * ia) // 255
    dst[index + 1] = (dst[index + 1] * inv + color[1] * ia) // 255
    dst[index + 2] = (dst[index + 2] * inv + color[2] * ia) // 255
    dst[index + 3] = 255


def point_in_triangle(px: float, py: float, ax: float, ay: float, bx: float, by: float, cx: float, cy: float) -> bool:
    def edge(x1: float, y1: float, x2: float, y2: float, x3: float, y3: float) -> float:
        return (x1 - x3) * (y2 - y3) - (x2 - x3) * (y1 - y3)

    d1 = edge(px, py, ax, ay, bx, by)
    d2 = edge(px, py, bx, by, cx, cy)
    d3 = edge(px, py, cx, cy, ax, ay)
    has_negative = d1 < 0 or d2 < 0 or d3 < 0
    has_positive = d1 > 0 or d2 > 0 or d3 > 0
    return not (has_negative and has_positive)


def mountain_peaks(horizon: float) -> tuple[tuple[float, ...], tuple[float, ...]]:
    back = (0.10, horizon, 0.36, 0.38, 0.56, horizon)
    front = (0.32, horizon, 0.56, 0.27, 0.90, horizon)
    return back, front


def mountain_color(nx: float, ny: float, horizon: float) -> tuple[int, int, int, int] | None:
    back, front = mountain_peaks(horizon)
    if point_in_triangle(nx, ny, *front):
        return MOUNTAIN_FRONT
    if point_in_triangle(nx, ny, *back):
        return MOUNTAIN_BACK
    return None


def render_icon(size: int) -> bytearray:
    pixels = bytearray(size * size * 4)
    margin = size * 0.06
    radius = size * 0.22
    horizon = 0.63
    samples = ((0.25, 0.25), (0.75, 0.25), (0.25, 0.75), (0.75, 0.75))
    horizon_band = 0.01

    for y in range(size):
        for x in range(size):
            clip = rounded_rect_coverage(x, y, margin, margin, size - margin, size - margin, radius)
            if clip <= 0:
                continue
            sky = 0
            lake = 0
            back_peak = 0
            front_peak = 0
            reflection_back = 0
            reflection_front = 0
            line = 0
            for ox, oy in samples:
                nx = (x + ox) / size
                ny = (y + oy) / size
                if abs(ny - horizon) <= horizon_band:
                    line += 1
                    continue
                if ny >= horizon:
                    lake += 1
                    mountain = mountain_color(nx, 2 * horizon - ny, horizon)
                    if mountain is MOUNTAIN_FRONT:
                        reflection_front += 1
                    elif mountain is MOUNTAIN_BACK:
                        reflection_back += 1
                else:
                    mountain = mountain_color(nx, ny, horizon)
                    if mountain is MOUNTAIN_FRONT:
                        front_peak += 1
                    elif mountain is MOUNTAIN_BACK:
                        back_peak += 1
                    else:
                        sky += 1
            total = len(samples)
            color = SKY
            if lake + reflection_back + reflection_front >= total / 2:
                if reflection_front:
                    color = REFLECTION
                elif reflection_back:
                    color = (74, 128, 156, 255)
                else:
                    color = LAKE
            elif front_peak:
                color = MOUNTAIN_FRONT
            elif back_peak:
                color = MOUNTAIN_BACK
            if line >= total / 2:
                color = HORIZON
            blend(pixels, (y * size + x) * 4, color, clip)
    return pixels


def main() -> None:
    ASSETS.mkdir(parents=True, exist_ok=True)
    write_png(ASSETS / "app-icon.png", 512, 512, render_icon(512))
    write_png(ASSETS / "app-icon@2x.png", 1024, 1024, render_icon(1024))
    print(f"wrote {ASSETS / 'app-icon.png'} and {ASSETS / 'app-icon@2x.png'}")


if __name__ == "__main__":
    main()
